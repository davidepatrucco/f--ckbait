# Template di configurazione per LemonSqueezer
# Copia questo file come .env e inserisci i tuoi valori

# OpenAI API Key (richiesto)
# Ottieni la tua chiave da: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Environment di deploy (dev, staging, prod)
# Determina il nome dello stack AWS e le risorse create
ENVIRONMENT=dev

# AWS Region dove fare il deploy
# Usa una region vicina a te per performance migliori
AWS_REGION=eu-west-1

# Optional: permitted web origins, comma-separated. Never use * in production.
ALLOWED_ORIGINS=

# Note:
# - Non committare mai il file .env nel repository
# - Il file .env è già nel .gitignore per sicurezza
# - Tutti questi parametri sono obbligatori per il deploy
